@model List<Recipe>
@{
	ViewData["Title"] = "Рецепти";
}

<h1>Рецепти</h1>

<table class="table table-striped">
	<thead>
		<tr>
			<th>Име</th>
			<th>Минути</th>
			<th>Описание</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var r in Model)
		{
			<tr>
				<td>@r.Name</td>
				<td>@r.Minutes</td>
				<td>@r.Description</td>
				<td>
					<a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-primary">Виж</a>
				</td>
			</tr>
		}
	</tbody>
</table>