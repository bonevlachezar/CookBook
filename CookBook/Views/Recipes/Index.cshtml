@model List<Recipe>
@{
	ViewData["Title"] = "Рецепти";
}

<h1>Рецепти</h1>
<a asp-action="Create" class="btn btn-success mb-3">+ Нова рецепта</a>
<form asp-action="Index" method="get" class="mb-3 d-flex gap-2">
	<input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Търси рецепта..." />
	<button type="submit" class="btn btn-primary">Търси</button>
</form>
<table class="table table-striped">
	<thead>
		<tr>
			<th>Име</th>
			<th>Минути</th>
			<th>Описание</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var r in Model)
		{
			<tr>
				<td>@r.Name</td>
				<td>@r.Minutes</td>
				<td>@r.Description</td>
				<td>
					<a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-primary">Виж</a>
				</td>
			</tr>
		}
	</tbody>
</table>