@model List<Category>
@{
	ViewData["Title"] = "Категории";
}

<h1>Категории</h1>
<table class="table table-striped">
	<thead>
		<tr>
			<th>Име</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var c in Model)
		{
			<tr>
				<td>@c.Name</td>
				<td>
					<a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-primary">Виж</a>
				</td>
			</tr>
		}
	</tbody>
</table>