@model Category
@{
	ViewData["Title"] = "Изтриване на категория";
}

<h1>Изтриване на категория</h1>

@if (Model.Recipes.Count > 0)
{
	<div class="alert alert-warning">
		Категорията <strong>@Model.Name</strong> не може да бъде изтрита,
		защото в нея има @Model.Recipes.Count рецепти. Първо ги преместете в друга категория или ги изтрийте.
	</div>

	<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Назад</a>
}
else
{
	<div class="alert alert-danger">
		Сигурни ли сте, че искате да изтриете категорията <strong>@Model.Name</strong>?
	</div>

	<form asp-action="Delete" method="post">
		<input type="hidden" asp-for="Id" />
		<button type="submit" class="btn btn-danger">Изтрий</button>
		<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Отказ</a>
	</form>
}